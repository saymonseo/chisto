<Window x:Class="Chisto.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Чисто — контроль пространства" Icon="Assets/app.ico" Width="1490" Height="950" MinWidth="1180" MinHeight="800" Background="{DynamicResource Theme_0C111B}" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Foreground="{DynamicResource Theme_E8EEF9}" Language="ru-RU">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="218" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Theme_0E1521}" BorderBrush="{DynamicResource Theme_222D40}" BorderThickness="0,0,1,0">
      <Grid Margin="17,25,17,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="96" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
            <Image Source="Assets/app.png" Width="38" Height="38" />
            <StackPanel Margin="11,0,0,0">
              <TextBlock Text="Чисто" FontFamily="Bahnschrift" FontWeight="SemiBold" FontSize="25" />
              <TextBlock Text="STORAGE WORKSPACE" FontSize="8" Foreground="{DynamicResource Theme_7588A6}" Margin="1,2,0,0" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="ОБЗОР" Style="{StaticResource Subtle}" FontSize="10" Margin="13,0,0,13" />
          <Button x:Name="NavMap" Style="{StaticResource Nav}" Click="MapPage_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,12,0" />
              <TextBlock Text="Карта диска" />
            </StackPanel>
          </Button>
          <Button x:Name="NavFiles" Style="{StaticResource Nav}" Click="FilesPage_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,12,0" />
              <TextBlock Text="Крупные файлы" />
            </StackPanel>
          </Button>
          <Button x:Name="NavDuplicates" Style="{StaticResource Nav}" Click="DuplicatesPage_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,12,0" />
              <TextBlock Text="Дубликаты" />
            </StackPanel>
          </Button>
          <TextBlock Text="ПРИЛОЖЕНИЯ" Style="{StaticResource Subtle}" FontSize="10" Margin="13,29,0,13" />
          <Button x:Name="NavAppData" Style="{StaticResource Nav}" Click="AppDataPage_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,12,0" />
              <TextBlock Text="Данные AppData" />
            </StackPanel>
          </Button>
          <Button x:Name="NavClean" Style="{StaticResource Nav}" Click="CleanPage_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,12,0" />
              <TextBlock Text="Очистка кэшей" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <TextBlock Text="ТЕМА" Style="{StaticResource Subtle}" FontSize="10" Margin="12,0,0,8" />
          <ComboBox x:Name="ThemeSelector" Height="36" Margin="0,0,0,12" SelectionChanged="Theme_Changed" AutomationProperties.Name="Тема оформления">
            <ComboBoxItem Content="Тёмная" Tag="dark" />
            <ComboBoxItem Content="Светлая" Tag="light" />
          </ComboBox>
          <Button x:Name="NavUpdates" Style="{StaticResource Nav}" Click="UpdatesPage_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,12,0" />
              <TextBlock Text="Обновления" />
            </StackPanel>
          </Button>
          <Border Background="{DynamicResource Theme_151F30}" CornerRadius="10" Padding="14" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="Ваш компьютер. Ваши данные." FontSize="11" />
              <TextBlock Text="Анализ выполняется локально." Style="{StaticResource Subtle}" FontSize="10" Margin="0,6,0,8" />
              <TextBlock x:Name="VersionLabel" Text="Чисто  /  0.2.0" Foreground="{DynamicResource Theme_7E98BE}" FontSize="10" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,23,28,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="Пространство под контролем" Style="{StaticResource Title}" />
          <TextBlock x:Name="PageIntro" Text="Найдите то, что занимает диск. Решите, что оставить." Style="{StaticResource Subtle}" Margin="0,7,0,0" />
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource Theme_132A28}" CornerRadius="12" Padding="12,6" VerticalAlignment="Top">
          <TextBlock Text="●  Локальный анализ" Foreground="{DynamicResource Theme_86D5BF}" FontSize="10" />
        </Border>
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="42" />
          <RowDefinition Height="111" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="DrivePicker" SelectionChanged="Drive_Changed" Margin="0,0,10,0" ToolTip="Диск для анализа" />
          <TextBox x:Name="RootBox" Grid.Column="1" IsReadOnly="True" Text="C:\" FontSize="12" VerticalContentAlignment="Center" />
          <Button x:Name="FolderButton" Grid.Column="2" Content="Выбрать папку" Click="ChooseFolder_Click" Margin="10,0" />
          <Button x:Name="ScanButton" Grid.Column="3" Content="Сканировать" Style="{StaticResource Primary}" Click="Scan_Click" MinWidth="142" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,17,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Panel}" Padding="18,13" Margin="0,0,12,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="ЗАНЯТО НА ДИСКЕ" Style="{StaticResource Subtle}" FontSize="10" />
                <TextBlock x:Name="UsedLabel" Text="—" FontFamily="Bahnschrift" FontSize="30" Margin="0,7,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ProgressBar x:Name="DriveBar" Height="5" Background="{DynamicResource Theme_273245}" Foreground="{DynamicResource Theme_83B5FF}" BorderThickness="0" />
                <TextBlock x:Name="DriveTotal" Style="{StaticResource Subtle}" FontSize="9" Margin="0,10,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="18,13" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="СВОБОДНО" Style="{StaticResource Subtle}" FontSize="10" />
              <TextBlock x:Name="FreeLabel" Text="—" Foreground="{DynamicResource Theme_8CDCC3}" FontFamily="Bahnschrift" FontSize="30" Margin="0,7,0,0" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="18,13" BorderBrush="{DynamicResource Theme_354C71}">
            <StackPanel>
              <TextBlock Text="В ОБЛАСТИ АНАЛИЗА" Style="{StaticResource Subtle}" FontSize="10" />
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="AnalyzedLabel" Text="—" FontFamily="Bahnschrift" FontSize="30" Margin="0,7,14,0" />
                <TextBlock x:Name="FileCountLabel" Text="Ожидает сканирования" Style="{StaticResource Subtle}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="130" Margin="0,7,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <Grid Grid.Row="2">
        <Grid x:Name="MapPage">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.7*" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="*" MinWidth="310" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Panel}" Padding="17">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <DockPanel>
                <TextBlock Text="Карта пространства" FontSize="16" FontWeight="SemiBold" />
                <Button x:Name="UpButton" Content="↑  Выше" Padding="11,5" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Up_Click" IsEnabled="False" />
              </DockPanel>
              <TextBlock x:Name="Breadcrumb" Grid.Row="1" Text="Выберите область анализа" Style="{StaticResource Subtle}" FontSize="10" Margin="0,10,0,14" TextTrimming="CharacterEllipsis" />
              <Border Grid.Row="2" Background="{DynamicResource Theme_0D1420}" CornerRadius="9" ClipToBounds="True">
                <Grid>
                  <Canvas x:Name="MapCanvas" SizeChanged="Map_SizeChanged" />
                  <StackPanel x:Name="MapEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="{DynamicResource Theme_526D96}" FontSize="40" HorizontalAlignment="Center" />
                    <TextBlock Text="Посмотрите на диск целиком" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0" />
                    <TextBlock Text="Выберите диск или папку и начните анализ." Style="{StaticResource Subtle}" HorizontalAlignment="Center" Margin="0,9,0,0" />
                  </StackPanel>
                </Grid>
              </Border>
              <TextBlock Grid.Row="3" Text="Площадь блока = размер папки. Нажмите на блок, чтобы перейти внутрь." Style="{StaticResource Subtle}" FontSize="10" TextWrapping="Wrap" Margin="0,13,0,0" />
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="0,14,0,0" ClipToBounds="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="Папки по размеру" FontWeight="SemiBold" FontSize="15" Margin="16,0,0,13" />
              <DataGrid x:Name="FolderGrid" Grid.Row="1" MouseDoubleClick="Folder_DoubleClick">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="ПАПКА" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="РАЗМЕР" Binding="{Binding DisplaySize}" SortMemberPath="Bytes" Width="105" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
        </Grid>
        <Grid x:Name="FilesPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,13">
            <TextBox x:Name="FileSearch" TextChanged="FileSearch_Changed" ToolTip="Поиск по имени и пути" AutomationProperties.Name="Поиск по имени и пути" />
            <TextBlock Text="Найти по имени или пути…" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Setter Property="Foreground" Value="{DynamicResource Theme_91A0B8}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text.Length, ElementName=FileSearch}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <Border Grid.Row="1" Style="{StaticResource Panel}" ClipToBounds="True">
            <DataGrid x:Name="FilesGrid" MouseDoubleClick="OpenFile_DoubleClick">
              <DataGrid.Columns>
                <DataGridTextColumn Header="ИМЯ ФАЙЛА" Binding="{Binding Name}" Width="250" />
                <DataGridTextColumn Header="РАЗМЕР" Binding="{Binding DisplaySize}" SortMemberPath="Bytes" Width="115" />
                <DataGridTextColumn Header="ТИП" Binding="{Binding TypeLabel}" Width="145" />
                <DataGridTextColumn Header="РАСПОЛОЖЕНИЕ" Binding="{Binding Folder}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,13,0,0">
            <Button Content="Показать в Проводнике" Click="RevealFile_Click" />
            <Button Content="Скопировать путь" Margin="10,0" Click="CopyFile_Click" />
            <TextBlock Text="1000 крупнейших файлов · сортировка по заголовку" Style="{StaticResource Subtle}" FontSize="10" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
        <Grid x:Name="DuplicatesPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,14">
            <Button x:Name="FindDuplicatesButton" Content="Найти одинаковые файлы" Style="{StaticResource Primary}" Click="FindDuplicates_Click" />
            <TextBlock x:Name="DuplicateSummary" Text="Файлы от 1 МБ · полная проверка содержимого по SHA-256" Style="{StaticResource Subtle}" Margin="17,0,0,0" VerticalAlignment="Center" />
          </DockPanel>
          <Border Grid.Row="1" Style="{StaticResource Panel}" ClipToBounds="True">
            <DataGrid x:Name="DuplicatesGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="ГРУППА" Binding="{Binding Group}" Width="80" />
                <DataGridTextColumn Header="РАЗМЕР КОПИИ" Binding="{Binding DisplaySize}" SortMemberPath="Bytes" Width="140" />
                <DataGridTextColumn Header="ПОЛНЫЙ ПУТЬ" Binding="{Binding Path}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,13,0,0">
            <Button Content="Показать выбранную копию" Click="RevealDuplicate_Click" />
            <Button Content="Экспорт CSV" Margin="10,0,0,0" Click="ExportDuplicates_Click" />
          </StackPanel>
        </Grid>
        <Grid x:Name="CleanPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,14">
            <Button x:Name="PreviewButton" Content="Проверить приложения" Style="{StaticResource Primary}" Click="Preview_Click" />
            <Button x:Name="CleanButton" Content="Очистить выбранное…" Margin="10,0,0,0" Click="Clean_Click" IsEnabled="False" />
            <TextBlock Text="Категории не выбраны по умолчанию" Style="{StaticResource Subtle}" FontSize="10" Margin="14,0,0,0" VerticalAlignment="Center" />
          </DockPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="340" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" ClipToBounds="True">
              <DataGrid x:Name="CacheGrid" IsReadOnly="False" SelectionChanged="CacheSelection_Changed">
                <DataGrid.Columns>
                  <DataGridCheckBoxColumn Header="✓" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                  <DataGridTextColumn Header="ПРИЛОЖЕНИЕ" Binding="{Binding Title}" IsReadOnly="True" Width="*" />
                  <DataGridTextColumn Header="КЭШ" Binding="{Binding DisplaySize}" IsReadOnly="True" SortMemberPath="Bytes" Width="93" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="15" ClipToBounds="True">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="CacheDescription" Text="Выберите категорию для подробностей" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="CacheDetails" Text="Будет удалён только известный кэш. Чаты, настройки, пароли и документы остаются на месте." Style="{StaticResource Subtle}" Margin="0,9,0,15" TextWrapping="Wrap" />
                <DataGrid x:Name="CacheFilesGrid" Grid.Row="2">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="ФАЙЛ · ПРЕДВАРИТЕЛЬНЫЙ СПИСОК" Binding="{Binding Path}" Width="*" />
                    <DataGridTextColumn Header="РАЗМЕР" Binding="{Binding DisplaySize}" SortMemberPath="Bytes" Width="100" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Border>
          </Grid>
          <TextBlock x:Name="CleanNote" Grid.Row="2" Text="Кэши текущего пользователя, независимо от диска. Удаление — после отдельного подтверждения." Style="{StaticResource Subtle}" FontSize="10" Margin="0,12,0,0" TextWrapping="Wrap" />
        </Grid>
        <Grid x:Name="AppDataPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel>
            <Button x:Name="AuditButton" Content="Проанализировать AppData" Style="{StaticResource Primary}" Click="AuditAppData_Click" />
            <TextBlock x:Name="AppDataSummary" Text="Local · Roaming · LocalLow" Style="{StaticResource Subtle}" Margin="15,0,0,0" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Grid.Row="1" Text="Общий объём данных приложения — это не объём мусора. Очистка доступна отдельно для известных кэшей." Style="{StaticResource Subtle}" Margin="0,13,0,14" TextWrapping="Wrap" />
          <Border Grid.Row="2" Style="{StaticResource Panel}" ClipToBounds="True">
            <DataGrid x:Name="AppDataGrid" MouseDoubleClick="AnalyzeApp_DoubleClick">
              <DataGrid.Columns>
                <DataGridTextColumn Header="ПРИЛОЖЕНИЕ / ПАПКА" Binding="{Binding Name}" Width="230" />
                <DataGridTextColumn Header="ОБЪЁМ ДАННЫХ" Binding="{Binding DisplaySize}" SortMemberPath="Bytes" Width="140" />
                <DataGridTextColumn Header="РАЗДЕЛ" Binding="{Binding Location}" Width="110" />
                <DataGridTextColumn Header="ДЕЙСТВИЕ" Binding="{Binding CacheHint}" Width="150" />
                <DataGridTextColumn Header="ПУТЬ" Binding="{Binding Path}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,13,0,0">
            <Button Content="Разобрать выбранную папку" Click="AnalyzeApp_Click" />
            <Button Content="Показать в Проводнике" Click="RevealApp_Click" Margin="10,0" />
            <Button Content="К очистке кэшей →" Click="CleanPage_Click" />
          </StackPanel>
        </Grid>
        <Grid x:Name="UpdatesPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource Panel}" Padding="25">
            <StackPanel>
              <TextBlock x:Name="UpdateVersionLabel" Text="Чисто 0.2.0" FontFamily="Bahnschrift" FontSize="27" />
              <TextBlock x:Name="UpdateSourceLabel" Text="Источник: GitHub Releases" Style="{StaticResource Subtle}" Margin="0,9,0,0" />
              <TextBlock x:Name="UpdateStatus" Text="Проверьте, опубликована ли новая версия." FontSize="14" Margin="0,24,0,20" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal">
                <Button x:Name="CheckUpdateButton" Content="Проверить обновления" Style="{StaticResource Primary}" Click="CheckUpdates_Click" />
                <Button x:Name="InstallUpdateButton" Content="Скачать установщик…" Margin="10,0,0,0" Click="DownloadUpdate_Click" IsEnabled="False" />
              </StackPanel>
              <TextBlock Text="Приложение обращается только к указанному репозиторию. Ваши файлы на GitHub не отправляются. Установка новой версии запускается вами отдельно." Style="{StaticResource Subtle}" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" Margin="0,22,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <Border Grid.Row="3" Style="{StaticResource Panel}" BorderBrush="{DynamicResource Theme_304767}" Padding="18,12" Margin="0,18,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel>
            <TextBlock x:Name="OperationTitle" Text="Готово к работе" FontSize="13" FontWeight="SemiBold" />
            <TextBlock x:Name="RemainingLabel" Text="Осталось —" Foreground="{DynamicResource Theme_91A0B8}" FontSize="12" Margin="16,0,0,0" />
          </DockPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <TextBlock x:Name="PercentLabel" Text="—" Foreground="{DynamicResource Theme_83B5FF}" FontFamily="Bahnschrift" FontSize="23" Margin="15,-4,15,0" />
            <Button x:Name="CancelButton" Content="Остановить" Padding="10,4" Visibility="Collapsed" Click="Cancel_Click" />
          </StackPanel>
          <ProgressBar x:Name="WorkBar" Grid.Row="1" Grid.ColumnSpan="2" Height="5" Foreground="{DynamicResource Theme_83B5FF}" Background="{DynamicResource Theme_243249}" BorderThickness="0" Margin="0,9,0,10" />
          <TextBlock x:Name="ProgressCount" Grid.Row="2" Text="Выберите диск или папку" Style="{StaticResource Subtle}" FontSize="11" />
          <TextBlock x:Name="TimeLabel" Grid.Row="2" Grid.Column="1" Text="Время —  ·  Осталось —" Style="{StaticResource Subtle}" FontSize="11" Margin="15,0,0,0" />
        </Grid>
      </Border>
      <TextBlock x:Name="StatusLabel" Grid.Row="4" Text="Анализ ничего не меняет на диске." Style="{StaticResource Subtle}" FontSize="10" Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
    </Grid>
  </Grid>
</Window>